# Server — 0.0.0.0 = accept connections from any LAN interface
SERVER_HOST=0.0.0.0
SERVER_PORT=5174
SERVER_GLOBAL_PREFIX=/v1/api
SERVER_DATABASE_URL=database.sqlite
SERVER_LOGGER=false

# Client — 0.0.0.0 = Vite reachable from phone on LAN (live reload)
CLIENT_HOST=0.0.0.0
CLIENT_PORT=5173

# Optional Capacitor override (leave unset to auto-detect / Settings UI)
# Emulator: http://10.0.2.2:5174/v1/api
# Phone:    http://<LAN-IP>:5174/v1/api
# VITE_API_URL=
