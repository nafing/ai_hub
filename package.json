{
  "name": "ai_hub",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter=!@ai_hub/client --filter=!@ai-hub/android-app run build && pnpm run build:android",
    "build:web": "pnpm -r --filter=!@ai-hub/android-app run build",
    "build:server": "pnpm --filter @ai-hub/shared --filter @ai_hub/server run build",
    "build:android": "pnpm --filter @ai-hub/android-app build",
    "start": "pnpm run build:server && pnpm --filter @ai_hub/server start",
    "start:server": "pnpm --filter @ai_hub/server start",
    "dev": "pnpm -r --parallel --filter=!@ai-hub/android-app run dev",
    "dev:server": "pnpm --filter @ai_hub/server dev",
    "android": "pnpm --filter @ai-hub/android-app build",
    "android:sync": "pnpm --filter @ai_hub/client android:sync",
    "android:open": "pnpm --filter @ai_hub/client android:open",
    "android:dev": "pnpm --filter @ai_hub/client android:dev",
    "release:android": "pnpm --filter @ai-hub/android-app release",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "pnpm -r run check-types"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
