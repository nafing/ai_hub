{
  "name": "ai_hub",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "git pull --ff-only && turbo run dev",
    "dev:local": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.6",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
