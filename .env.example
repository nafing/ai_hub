# Server — use 0.0.0.0 to accept any LAN client
SERVER_HOST=0.0.0.0
SERVER_PORT=5174
SERVER_GLOBAL_PREFIX=/v1/api
SERVER_DATABASE_URL=database.sqlite
SERVER_LOGGER=false

# Client — use 0.0.0.0 so phones can reach Vite on LAN
CLIENT_HOST=0.0.0.0
CLIENT_PORT=5173

# Optional Capacitor API override (or set in Settings → Server on device)
# Emulator: http://10.0.2.2:5174/v1/api
# Phone:    http://<LAN-IP>:5174/v1/api
# VITE_API_URL=
