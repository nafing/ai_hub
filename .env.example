# Server
# Use 0.0.0.0 so Capacitor / phones on LAN can reach the API
SERVER_HOST=0.0.0.0
SERVER_PORT=5174
SERVER_GLOBAL_PREFIX=/v1/api
SERVER_DATABASE_URL=database.sqlite
SERVER_LOGGER=false

# Client
CLIENT_HOST=127.0.0.1
CLIENT_PORT=5173

# Required for Capacitor builds (no Vite proxy). Use your PC's LAN IP.
# Android emulator can use http://10.0.2.2:5174/v1/api instead.
# VITE_API_URL=http://192.168.0.208:5174/v1/api
